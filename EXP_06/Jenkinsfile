pipeline {
  agent any
  stages {
    stage('Checkout')     { steps { checkout scm } }
    stage('Install')      { steps { sh 'pip install -r requirements.txt' } }
    stage('Run ML Test')  { steps { sh 'pytest' } }
    stage('Docker Build') { steps { sh 'docker build -t ml-ticket-app .' } }
    stage('Deploy')       { steps { sh 'docker rm -f ml-ticket-app || true && docker run -d --name ml-ticket-app -p 5002:5000 ml-ticket-app' } }
  }
  post { success { echo 'Deployed at http://localhost:5002' } }
}
